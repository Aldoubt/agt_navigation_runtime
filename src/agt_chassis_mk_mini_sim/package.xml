<?xml version="1.0"?>
<package format="3">
  <name>agt_chassis_mk_mini_sim</name>
  <version>0.1.0</version>
  <description>Development-only MK-mini virtual VCU simulator for the vcan0 software-HIL loop.</description>
  <maintainer email="xuanyang.robotics@gmail.com">Xuan Yang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>agt_chassis_mk_mini</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
