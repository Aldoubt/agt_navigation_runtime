# Generic camera capability request. Hardware-specific controls stay behind the capability boundary.
string request_id
string camera_id
string waypoint_id
float64 target_heading
float64 target_pitch
string capture_tag
bool save_image
---
uint16 ERROR_NONE=0
uint16 ERROR_INVALID_REQUEST=1
uint16 ERROR_CAMERA_UNAVAILABLE=2
uint16 ERROR_CAPTURE_FAILED=3
uint16 ERROR_CANCELED=4

bool success
uint16 error_code
sensor_msgs/Image image
string image_uri
string message
float64 actual_heading
float64 actual_pitch
builtin_interfaces/Time capture_stamp
