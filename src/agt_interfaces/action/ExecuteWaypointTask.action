# Formal execution input. The server resolves the task JSON through the robot-side
# Task Registry below runtime/maps; frontends must not submit file paths.
string map_id
string map_version_id
string task_group_id
uint32 task_revision
string expected_content_sha256
# A loop count is always finite. 1 executes the task once.
uint32 loop_count
# Idempotency key generated by the client for a start request.
string client_request_id

# Deprecated compatibility inputs. Disabled by default on the server and limited
# to same-machine CLI/debug when explicitly enabled.
string task_file
geometry_msgs/PoseStamped[] poses
bool loop
---
bool success
uint16 error_code
string message
string session_id
string blocker_code
string operator_message
string technical_message
bool duplicate_request
int32[] missed_waypoints
agt_interfaces/NavigationSessionStatus final_status
---
string state
uint32 loop_index
uint32 current_waypoint
uint32 total_waypoints
agt_interfaces/NavigationSessionStatus status
