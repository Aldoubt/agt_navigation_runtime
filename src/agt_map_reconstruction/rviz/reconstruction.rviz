Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 20
      Target Frame: map
  Window Geometry:
    Height: 900
    Width: 1600
    X: 50
    Y: 50
  Panels:
    - Class: rviz_common/Displays
      Name: Displays
    - Class: rviz_common/Views
      Name: Views
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: registered_points
      Topic: /agt/odometry/registered_points
      Size (m): 0.03
      Style: Points
    - Class: rviz_default_plugins/Odometry
      Name: fast_livo_odometry
      Topic: /agt/odometry/odometry
      Shape: Arrow
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Map
      Name: navigation_map
      Topic: /navigation_map
      Alpha: 0.75
    - Class: rviz_default_plugins/Map
      Name: elevation_map
      Topic: /elevation_map
      Alpha: 0.45
    - Class: rviz_default_plugins/Map
      Name: traversability_map
      Topic: /traversability_map
      Alpha: 0.65
  Fixed Frame: map
