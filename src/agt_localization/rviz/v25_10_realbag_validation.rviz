Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Fixed Frame: map
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Reference Localization Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agt/localization/reference_map
      Enabled: true
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 255; 255
    - Class: rviz_default_plugins/PointCloud2
      Name: Current Registered Cloud (visible after map->odom)
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /agt/odometry/registered_points
      Enabled: false
      Style: Points
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/PointCloud2
      Name: Aligned Cloud
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /agt/localization/aligned_points
      Enabled: true
      Style: Points
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/PointCloud2
      Name: Initial Guess
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /agt/localization/initial_guess
      Enabled: true
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 170; 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Aligned Candidate
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /agt/localization/aligned_candidate
      Enabled: true
      Style: Points
      Color Transformer: FlatColor
      Color: 0; 170; 255
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Candidate Pose
      Topic: /agt/localization/candidate_pose
      Enabled: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Accepted Global Pose
      Topic: /agt/localization/global_pose
      Enabled: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Topic: /agt/odometry/odometry
      Enabled: true
  Tools:
    - Class: rviz_default_plugins/Interact
  Name: root
