<?xml version="1.0"?>
<package format="3">
  <name>agt_field_commissioning</name>
  <version>0.1.0</version>
  <description>Commissioning-only field mapping and frozen-site navigation entry points.</description>
  <maintainer email="xuanyang.robotics@gmail.com">Xuan Yang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>agt_runtime_contracts</exec_depend>
  <exec_depend>agt_site_runtime</exec_depend>
  <exec_depend>agt_site_navigation</exec_depend>
  <exec_depend>agt_hardware_bringup</exec_depend>
  <exec_depend>agt_odometry</exec_depend>
  <exec_depend>agt_sensor_adapters</exec_depend>
  <exec_depend>agt_perception</exec_depend>
  <exec_depend>agt_localization</exec_depend>
  <exec_depend>agt_navigation</exec_depend>
  <exec_depend>agt_mission_manager</exec_depend>
  <exec_depend>agt_safety</exec_depend>
  <exec_depend>agt_system_manager</exec_depend>
  <exec_depend>fast_livo</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
