# Project-owned mapping-session workflow. Frontends must not reproduce the
# save-grid -> stop-mapping -> wait-PCD -> commit-version sequence.
uint8 OP_STATUS=0
uint8 OP_START=1
uint8 OP_FINALIZE_CAPTURE=2
uint8 OP_COMMIT=3
uint8 OP_DISCARD=4

uint8 operation
# Required for START. A safe portable identifier, not a filesystem path.
string map_id
# Required for operations on an existing session. STATUS may leave it empty to
# query the newest managed session.
string session_id
# START-only mapping profile arguments. The server injects and owns runtime_dir,
# map_name, mapping_output_dir, record_bag, and bag_profile.
string[] argument_keys
string[] argument_values
# COMMIT-only. Activation still performs the full map-registry validation.
bool activate_after_commit
# Bounded wait for map save, normal shutdown, PCD readiness, and offline candidate build.
float64 timeout_s
---
uint16 ERROR_NONE=0
uint16 ERROR_INVALID_REQUEST=1
uint16 ERROR_SERVER_UNAVAILABLE=2
uint16 ERROR_START_FAILED=3
uint16 ERROR_GRID_SAVE_FAILED=4
uint16 ERROR_STOP_FAILED=5
uint16 ERROR_ASSET_TIMEOUT=6
uint16 ERROR_COMMIT_FAILED=7
uint16 ERROR_INVALID_STATE=8
uint16 ERROR_NOT_FOUND=9
uint16 ERROR_INTERNAL=255

bool success
uint16 error_code
string state
string session_id
string map_id
string map_version_id
string session_file
string candidate_map_yaml
string candidate_map_image
string localization_pcd
string processing_record
string bag_directory
string registered_map_yaml
string tasks_directory
string message
---
string state
float32 progress
string message
