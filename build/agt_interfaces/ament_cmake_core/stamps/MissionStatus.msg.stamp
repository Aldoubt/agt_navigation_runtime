# Authoritative status for one finite sequential mission.
uint8 STATE_IDLE=0
uint8 STATE_VALIDATING=1
uint8 STATE_RUNNING=2
uint8 STATE_WAITING_DURATION=3
uint8 STATE_WAITING_EVENT=4
uint8 STATE_PAUSING=5
uint8 STATE_PAUSED=6
uint8 STATE_RESUMING=7
uint8 STATE_CANCELING=8
uint8 STATE_SUCCEEDED=9
uint8 STATE_FAILED=10
uint8 STATE_CANCELED=11
uint8 STATE_INTERRUPTED=12

uint8 STEP_UNKNOWN=0
uint8 STEP_WAYPOINT_TASK=1
uint8 STEP_WAIT_DURATION=2
uint8 STEP_WAIT_EVENT=3

uint16 ERROR_NONE=0
uint16 ERROR_INVALID_MISSION=1
uint16 ERROR_MAP_MISMATCH=2
uint16 ERROR_READINESS_LOST=3
uint16 ERROR_LOCALIZATION_LOST=4
uint16 ERROR_CHILD_REJECTED=5
uint16 ERROR_CHILD_FAILED=6
uint16 ERROR_EVENT_TIMEOUT=7
uint16 ERROR_CANCELED=8
uint16 ERROR_RESUME_BLOCKED=9
uint16 ERROR_INTERNAL=255

std_msgs/Header header
uint8 state
string mission_id
string mission_version
string content_sha256
string map_id
string map_version_id
string map_manifest_sha256
uint32 current_step_index
uint32 total_steps
string current_step_id
uint8 current_step_type
uint32 current_waypoint
uint32 total_waypoints
float64 step_elapsed_s
float64 step_remaining_s
uint16 error_code
string[] blocker_codes
string[] blocker_messages
string message
