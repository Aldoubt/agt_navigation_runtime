# Main runtime mode transition. The server may only use configured profiles.
uint8 MODE_IDLE=0
uint8 MODE_SENSOR_ONLY=1
uint8 MODE_MAPPING=2
uint8 MODE_LOCALIZATION_DEBUG=3
uint8 MODE_NAVIGATION=4
uint8 MODE_ERROR=5

uint8 mode
string profile
string[] argument_keys
string[] argument_values
bool wait_for_health
float64 startup_timeout_s
---
bool success
uint16 error_code
string active_mode
string profile
int32[] process_ids
string[] log_paths
string message
---
string state
float32 progress
string message
