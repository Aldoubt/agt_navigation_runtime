<?xml version="1.0"?>
<package format="3">
  <name>agt_sensor_monitor</name>
  <version>0.1.0</version>
  <description>Read-only sensor stream health evidence for the AGT system manager.</description>
  <maintainer email="yangxuan@example.com">yangxuan</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>diagnostic_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <!-- livox_ros_driver2 is intentionally optional at CMake time because it is
       not a rosdep-resolvable system dependency in the baseline workspace. -->
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
