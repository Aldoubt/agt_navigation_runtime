<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_gimbal_capability</name>
  <version>1.0.0</version>
  <description>Navigation-independent camera-gimbal atomic capability for ROS2.</description>
  <maintainer email="autolabor@autolabor.com.cn">autolabor</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>camera_gimbal_interfaces</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>pantilt_camera_serial</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
