<?xml version="1.0"?>
<package format="3">
  <name>camera_gimbal_manager</name>
  <version>0.1.0</version>
  <description>Stable feedback and state estimator for the C1 camera gimbal.</description>
  <maintainer email="autolabor@autolabor.com.cn">autolabor</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>camera_gimbal_msgs</depend>
  <depend>pantilt_camera_serial</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
